{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anti-llm:lexicon:resource:1",
  "title": "Anti-LLM separate text resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceId",
    "encoding",
    "text"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "encoding": {
      "const": "utf-8"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "description": "Untrusted text data for a future isolated resource process. The build adapters do not read this document."
}
